# Copy to e2e/.env.e2e (gitignored) and fill in. Do not commit secrets.
# Or export the same vars in your shell before `make e2e` / `pnpm e2e`.

# Base URLs (local stack defaults)
E2E_WEB_URL=http://127.0.0.1:5173
E2E_ADMIN_URL=http://127.0.0.1:5174
E2E_API_URL=http://127.0.0.1:18080

# Bootstrap platform_admin (same as BOOTSTRAP_ADMIN_* on API)
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=change-me

# Optional fixed chat user (otherwise tests register a unique user)
# E2E_USER_USERNAME=
# E2E_USER_PASSWORD=

# Mock LLM (OpenAI-compatible). Default on for chat streaming tests.
# Start: pnpm --dir e2e mock-llm   → http://127.0.0.1:18099/v1
E2E_MOCK_LLM=1
E2E_MOCK_LLM_URL=http://127.0.0.1:18099/v1
E2E_MOCK_LLM_PORT=18099

# Slow stream delay (ms per token) for stop / resume / interrupt tests
E2E_MOCK_LLM_TOKEN_DELAY_MS=40
