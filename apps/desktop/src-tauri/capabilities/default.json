{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Open Bot desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "allow-host-stat",
    "allow-host-ls",
    "allow-host-read",
    "allow-host-write",
    "allow-host-delete",
    "allow-host-move",
    "allow-host-open",
    "allow-host-shell"
  ]
}
